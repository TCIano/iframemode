{
  "name": "iframemode",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build --force && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix && stylelint \"src/**/*.{vue,less,css}\" --fix",
    "lint:style": "stylelint \"src/**/*.{vue,less,css}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,less}\"",
    "prepare": "husky",
    "gen:api": "plop api",
    "gen:page": "plop page",
    "gen:component": "plop component",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check:test": "vue-tsc --build --force tsconfig.vitest.json",
    "test:e2e": "playwright test"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix",
      "prettier --write",
      "stylelint --fix"
    ],
    "*.{css,less}": [
      "prettier --write",
      "stylelint --fix"
    ]
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@vueuse/core": "^11.3.0",
    "ant-design-vue": "^4.2.2",
    "axios": "^1.6.5",
    "dayjs": "^1.11.10",
    "echarts": "^5.5.1",
    "less": "^4.2.0",
    "less-loader": "^11.1.4",
    "pinia": "^2.1.7",
    "vue": "^3.3.11",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.3.0",
    "@playwright/test": "^1.62.1",
    "@tsconfig/node18": "^18.2.2",
    "@types/node": "^18.19.3",
    "@vitejs/plugin-vue": "^4.5.2",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.5.0",
    "commitlint": "^21.2.1",
    "eslint": "^9.3.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-perfectionist": "^3.0.0",
    "eslint-plugin-vue": "^9.26.0",
    "happy-dom": "^20.11.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "plop": "^4.0.5",
    "postcss-html": "^2.0.0",
    "postcss-less": "^6.0.0",
    "prettier": "^3.2.5",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~5.3.0",
    "typescript-eslint": "^8.0.0-alpha.20",
    "vite": "^5.0.10",
    "vite-plugin-vue-devtools": "^7.2.1",
    "vitest": "^3.2.7",
    "vue-tsc": "^1.8.25"
  }
}
